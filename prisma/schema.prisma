// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

enum PaymentPlan {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MatchType {
  FRIENDLY
  TOURNAMENT
  LEAGUE
  TRAINING
}

enum NewsCategory {
  ANNOUNCEMENT
  TOURNAMENT
  TRAINING
  COMMUNITY
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  minAge      Int
  maxAge      Int
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coaches       Coach[]
  matches       Match[]
  registrations Registration[]
}

model Coach {
  id         String   @id @default(cuid())
  fullName   String
  role       String
  biography  String?
  image      String?
  phone      String?
  email      String?  @unique
  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories Category[]
}

model News {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  image       String?
  category    NewsCategory @default(ANNOUNCEMENT)
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Match {
  id        String    @id @default(cuid())
  title     String
  opponent  String?
  date      DateTime
  location  String
  type      MatchType
  result    String?
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Registration {
  id            String             @id @default(cuid())
  playerName    String
  birthDate     DateTime
  gender        String?
  guardianName  String
  guardianPhone String
  guardianEmail String?
  address       String?
  medicalNotes  String?
  paymentPlan   PaymentPlan        @default(MONTHLY)
  status        RegistrationStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}
